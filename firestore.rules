rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isStaff() { return signedIn() && role() in ['admin', 'staff']; }
    function isAdmin() { return signedIn() && role() == 'admin'; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /products/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // Step 3
    match /customers/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /sales/{id} {
      allow read, create, update: if isStaff();
      allow delete: if false;
    }
    match /payments/{id} {
      allow read, create: if isStaff();
      allow update, delete: if false;
    }

    // Step 4
    match /suppliers/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /purchases/{id} {
      allow read, create: if isStaff();
      allow update, delete: if false;
    }
    match /supplierPayments/{id} {
      allow read, create: if isStaff();
      allow update, delete: if false;
    }
    match /expenses/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /meta/{id} {
      allow read, write: if isStaff();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
