rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || role() == 'admin');
      allow write: if false; // Step 1: user Firebase Console theke banan
    }
    match /{document=**} {
      allow read, write: if false; // baki collection gulo porer step e khulbo
    }
  }
}
